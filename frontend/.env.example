# Copy to .env.local. NEXT_PUBLIC_ variables are copied into the browser code at build
# time, so never put a secret in one: anyone can read it in the page's JavaScript.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Vercel): the API's https:// address. The WebSocket then uses wss:// by itself.
#   NEXT_PUBLIC_API_URL=https://aicoaching-production.up.railway.app
