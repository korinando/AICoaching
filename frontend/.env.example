# Copy to .env.local. NEXT_PUBLIC_ variables are copied into the browser code at build
# time, so never put a secret in one: anyone can read it in the page's JavaScript.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Vercel): the API's https:// address. The WebSocket then uses wss:// by itself.
#   NEXT_PUBLIC_API_URL=https://aicoaching-production.up.railway.app
# Monitoring (Week 7 Step 6), on Vercel. Sentry → project (Next.js) → Client Keys. Not a secret:
# it only lets you send errors.
#   NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Optional, for readable stack traces. SENTRY_AUTH_TOKEN *is* a secret: Vercel only, never here.
#   SENTRY_ORG=<org slug>   SENTRY_PROJECT=<project slug>   SENTRY_AUTH_TOKEN=<token>
