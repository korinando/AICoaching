# Copy this file to .env and fill in real values. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
LLM_MODEL=gemini-3.5-flash-lite

# Same user/password/db as the root .env used by docker compose. Port 5433 = the container.
DATABASE_URL=postgresql+psycopg://coach:change-me@localhost:5433/ai_coach

# Signs login tokens (Step 4). At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=generate-a-long-random-value
