# Copy this file to .env and fill in real values. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
LLM_MODEL=gemini-3.5-flash-lite

# Same user/password/db as the root .env used by docker compose. Port 5433 = the container.
DATABASE_URL=postgresql+psycopg://coach:change-me@localhost:5433/ai_coach

# Signs login tokens (Step 4). At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=generate-a-long-random-value

# Recordings storage (S3 API). Same key values as in the root .env used by docker compose.
# 127.0.0.1 and not localhost: Windows tries IPv6 first, storage only listens on IPv4, and each
# new connection would lose 2 s to that.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-to-a-long-random-value
S3_BUCKET=ai-coach-recordings

# The job queue (Week 5). The worker in Docker gets its own value from docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Production only (set on Railway, not in a local .env) ─────────────────────────────────────
# Railway fills these from its own services: no address or password to copy by hand.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (postgresql:// is fine: the app adds +psycopg)
#   REDIS_URL=${{Redis.REDIS_URL}}
#   RQ_REDIS_URL=${{Redis.REDIS_URL}}         (worker only: `rq worker` reads it by itself)
# Only the real website may call the API from a browser. JSON list, no trailing slash.
#   CORS_ORIGINS=["https://offerward.vercel.app"]
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, with an R2 API token's keys.
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# A new JWT_SECRET and GEMINI_API_KEY for production, never the development ones.
# PORT is set by Railway (8080); the Dockerfile listens on it. Don't set it yourself.
